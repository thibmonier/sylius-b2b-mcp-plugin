<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping">

    <entity name="Tmonier\SyliusB2bMcpPlugin\Entity\OAuthClient" table="tmonier_b2b_mcp_client">
        <id name="id" column="id" type="integer">
            <generator strategy="AUTO" />
        </id>

        <field name="identifier" column="identifier" type="string" length="64" unique="true" />
        <field name="name" column="name" type="string" length="255" />
        <field name="redirectUris" column="redirect_uris" type="json" />
        <field name="dynamicallyRegistered" column="dynamically_registered" type="boolean">
            <options>
                <option name="default">1</option>
            </options>
        </field>
        <field name="secretHash" column="secret_hash" type="string" length="255" nullable="true" />
        <field name="createdAt" column="created_at" type="datetime_immutable" />
    </entity>

</doctrine-mapping>
