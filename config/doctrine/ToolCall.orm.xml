<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping">

    <mapped-superclass name="Tmonier\SyliusB2bMcpPlugin\Entity\ToolCall" table="tmonier_b2b_mcp_tool_call">
        <indexes>
            <index name="tmonier_b2b_mcp_tool_call_created_idx" columns="created_at" />
        </indexes>

        <id name="id" column="id" type="integer">
            <generator strategy="AUTO" />
        </id>

        <field name="customerEmail" column="customer_email" type="string" length="255" nullable="true" />
        <field name="clientName" column="client_name" type="string" length="255" nullable="true" />
        <field name="channelCode" column="channel_code" type="string" length="255" nullable="true" />
        <field name="tool" column="tool" type="string" length="64" />
        <field name="arguments" column="arguments" type="text" />
        <field name="outcome" column="outcome" type="string" length="16" />
        <field name="message" column="message" type="string" length="255" nullable="true" />
        <field name="durationMs" column="duration_ms" type="integer" />
        <field name="ipAddress" column="ip_address" type="string" length="45" nullable="true" />
        <field name="createdAt" column="created_at" type="datetime_immutable" />

        <!-- The entries go with the customer (GDPR erasure). -->
        <many-to-one field="customer" target-entity="Sylius\Component\Customer\Model\CustomerInterface">
            <join-column name="customer_id" referenced-column-name="id" nullable="true" on-delete="CASCADE" />
        </many-to-one>

        <many-to-one field="connection" target-entity="Tmonier\SyliusB2bMcpPlugin\Entity\ConnectionInterface">
            <join-column name="connection_id" referenced-column-name="id" nullable="true" on-delete="SET NULL" />
        </many-to-one>
    </mapped-superclass>

</doctrine-mapping>
